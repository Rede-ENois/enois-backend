# Jitsi próprio do Énóis — copie para .env e rode ./gen-secrets.sh antes de subir.
#
# Este arquivo NÃO tem segredo nenhum: os valores marcados como "gerar" são preenchidos pelo
# gen-secrets.sh na cópia local. O .env de verdade nunca entra no repositório.

#
# Básico
#

# Onde ficam as configurações geradas pelos containers (fora do repositório).
CONFIG=/srv/jitsi-cfg

# Portas publicadas no host. O TLS de verdade fica no proxy reverso da frente (ver README).
HTTP_PORT=8000
HTTPS_PORT=8443

TZ=America/Sao_Paulo

# Origem pública do Jitsi (stack antiga, só registro histórico), com https e sem barra no fim.
# As chamadas e as salas de mentoria de hoje ficam na Epapo: lá o host é o REDE_CALLS_EPAPO_URL
# do backend.
PUBLIC_URL=https://chamadas.example.com

# IP público (ou IPs, separados por vírgula) que o videobridge anuncia para a mídia. Sem isso os
# navegadores não conseguem trocar áudio/vídeo quando o servidor está atrás de NAT.
JVB_ADVERTISE_IPS=

# Porta UDP da mídia. Precisa estar liberada no firewall e no proxy/roteador da frente.
JVB_PORT=10000

#
# Autenticação por token (o backend assina, o Prosody confere)
#

ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt

# Identificador do app. Não é segredo, mas precisa ser o mesmo dos dois lados.
JWT_APP_ID=rede

# Segredo do JWT da stack antiga. GERAR — nunca reaproveitar. Na Epapo quem assina é o auth
# gateway dela, com o segredo que fica só lá.
JWT_APP_SECRET=

# Só aceita tokens emitidos pelo nosso backend.
JWT_ACCEPTED_ISSUERS=rede

# O token precisa trazer "aud" e ele tem que ser exatamente um destes valores. O plugin de token
# desse Prosody recusa token sem "aud" quando esta lista está preenchida. "meet.jitsi" é o
# VirtualHost interno dos containers e não muda com o domínio público. Só mude aqui E no
# consumidor do token.
JWT_ACCEPTED_AUDIENCES=meet.jitsi

# Nenhuma entrada sem token, nem para "convidado".
JWT_ALLOW_EMPTY=0

#
# O que a chamada NÃO faz
#

# Sem gravação, sem transmissão, sem transcrição: o token também desliga, isto fecha na origem.
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_VISITORS=0

# Sem sala de espera e sem tela de boas-vindas: o painel do app já é a entrada.
ENABLE_LOBBY=0
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0

# Nada de deep link para fora do app.
DISABLE_DEEP_LINKING=1

#
# Senhas internas dos serviços (XMPP entre web/prosody/jicofo/jvb). GERAR.
#

JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=

#
# Imagens
#

# Versão fixa: "unstable" muda sozinho e derruba a chamada sem ninguém mexer em nada.
JITSI_IMAGE_VERSION=stable-11248-3
RESTART_POLICY=unless-stopped
